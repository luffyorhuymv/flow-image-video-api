{
  "manifest_version": 3,
  "name": "Flow Request Capture",
  "version": "1.2.0",
  "description": "Ghi request Flow + tự đúc token reCAPTCHA và đẩy cookie tươi về proxy local.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Flow Request Capture" },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
